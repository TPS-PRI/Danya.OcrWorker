<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Danya.OcrWorker-8992417a-2efe-4af9-a069-95864d8fe328</UserSecretsId>
    <RootNamespace>Danya.OcrWorker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="5.5.1" />
    <PackageReference Include="NLog.Extensions.Logging" Version="5.3.12" />
  </ItemGroup>

  <!-- Plain Microsoft.NET.Sdk, unlike Sdk.Worker/Sdk.Web, does not auto-copy loose files to the
       output folder - without this, the built .exe finds no config file at all (not even a stale
       one) and every setting silently reads as empty/default. Note it's <None Update>, not
       <Content Update>: Shield's csproj (Microsoft.NET.Sdk.Web) implicitly globs loose files as
       Content items, so `Content Update` finds a match there - this project's implicit glob is
       None, so `Content Update` here would silently match nothing and copy nothing. -->
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="nlog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
